# Leave empty to use an in-memory database (data resets on restart)
MONGO_URL=mongodb://localhost:27017
DB_NAME=coinquest

# Optional - enables AI insights & auto-categorisation (falls back to rules when unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Signs session tokens - use a long random string in production
SECRET_KEY=

# true = OTP is returned in the API response instead of being sent by SMS
DEMO_MODE=true

# Comma-separated list, or * for any origin
CORS_ORIGINS=*

# Security (required when DEMO_MODE=false)
SECRET_KEY=
# AES-256 key for identity fields: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
WEBHOOK_SECRET=
ADMIN_API_KEY=
REQUIRE_HTTPS=false
IDLE_TIMEOUT_MINUTES=15
PUSH_ENABLED=false
