{
  "expo": {
    "name": "CoinQuest",
    "slug": "coinquest",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coinquest",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.coinquest"
    },
    "android": {
      "package": "app.coinquest",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16130F"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "CoinQuest",
      "themeColor": "#16130F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#16130F"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "CoinQuest uses the camera only to scan UPI payment QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
